# Project Parva public-safe configuration example
# Copy to .env and adjust only the values you need for your environment.

# Core runtime
PARVA_ENV=public
PARVA_LICENSE_MODE=AGPL-3.0-or-later
PARVA_SOURCE_URL=https://github.com/dantwoashim/Project_Parva
PARVA_SERVE_FRONTEND=false
PARVA_FRONTEND_DIST=./frontend/dist

# Public API shape
PARVA_ENABLE_EXPERIMENTAL_API=false
PARVA_SHOW_PRIVATE_SCHEMA=false
PARVA_ALLOW_EXPERIMENTAL_IN_PROD=false
PARVA_ALLOW_PUBLIC_UNVERIFIED_FUTURE_CONVERSION=false
PARVA_ROUTE_PROFILE=public_demo
PARVA_MAX_REQUEST_BYTES=1048576
PARVA_MAX_QUERY_LENGTH=4096

# Auth and partner overlays
# Leave blank for local development unless you are explicitly testing protected surfaces.
PARVA_ADMIN_TOKEN=
PARVA_API_KEYS=

# Billing and monetization
PARVA_BILLING_ENABLED=false
PARVA_DATABASE_URL=sqlite:///.parva-billing.sqlite3
PARVA_API_KEY_PEPPER=
PARVA_KHALTI_SECRET_KEY=
PARVA_KHALTI_PUBLIC_KEY=
PARVA_KHALTI_BASE_URL=https://dev.khalti.com/api/v2
PARVA_KHALTI_RETURN_URL=http://localhost:5173/pricing/success
PARVA_ESEWA_MERCHANT_ID=
PARVA_ESEWA_SECRET=
PARVA_ESEWA_BASE_URL=https://rc.esewa.com.np
PARVA_ESEWA_RETURN_URL=http://localhost:5173/pricing/success

# Rate limiting and cache
PARVA_RATE_LIMIT_ENABLED=true
PARVA_RATE_LIMIT_BACKEND=memory
PARVA_REDIS_URL=
PARVA_REQUIRE_PRECOMPUTED=false
PARVA_PREWARM_HOTSET=false
PARVA_PRECOMPUTED_STALE_HOURS=720
PARVA_RUNTIME_CACHE_ENABLED=true
PARVA_RUNTIME_CACHE_MAX_ENTRIES=128
PARVA_TRUSTED_PROXY_IPS=

# Optional high-precision JPL/NAIF ephemeris kernels.
# Download with:
#   python scripts/download_jpl_kernel.py --kernel de440
#   python scripts/download_jpl_kernel.py --kernel de441-part1
#   python scripts/download_jpl_kernel.py --kernel de441-part2
PARVA_JPL_DE440_KERNEL=./data/ephemeris/jpl/de440.bsp
PARVA_JPL_DE441_KERNEL=./data/ephemeris/jpl/de441_part-2.bsp
PARVA_JPL_DE441_KERNEL_PART1=./data/ephemeris/jpl/de441_part-1.bsp
PARVA_JPL_DE441_KERNEL_PART2=./data/ephemeris/jpl/de441_part-2.bsp

# Place search
PARVA_PLACE_SEARCH_ALLOW_REMOTE=true
PARVA_PLACE_SEARCH_PROVIDER_CHAIN=offline,nominatim
PARVA_PLACE_SEARCH_PROVIDER_POLICY=
PARVA_PLACE_SEARCH_ENDPOINT=https://nominatim.openstreetmap.org/search
PARVA_PLACE_SEARCH_USER_AGENT=ProjectParva/3.0 (+https://example.com/contact)
PARVA_PLACE_SEARCH_TIMEOUT_SECONDS=5.0
PARVA_PLACE_SEARCH_TIME_BUDGET_SECONDS=8.0
PARVA_PLACE_SEARCH_RETRY_ATTEMPTS=2
PARVA_PLACE_SEARCH_RETRY_BACKOFF_SECONDS=0.3
PARVA_PLACE_SEARCH_CACHE_TTL_SECONDS=3600

# Provenance signing
PARVA_PROVENANCE_ATTESTATION_KEY=
PARVA_PROVENANCE_ATTESTATION_KEY_FILE=
PARVA_PROVENANCE_ATTESTATION_KEY_ID=
PARVA_PROVENANCE_ATTESTATION_KEY_ID_FILE=
PARVA_BUILD_SHA=
PARVA_RELEASE_SHA=

# Frontend development
PARVA_DEV_API_TARGET=http://127.0.0.1:8000
VITE_API_BASE=https://api.prabinghimire1.com.np/v3/api
VITE_API_TIMEOUT_MS=10000

# Optional deployment/runtime integrations
CORS_ALLOW_ORIGINS=https://prabinghimire1.com.np,https://www.prabinghimire1.com.np,https://project-parva.pages.dev,http://localhost:5173
PARVA_CORS_ORIGINS=https://prabinghimire1.com.np,https://www.prabinghimire1.com.np,https://project-parva.pages.dev,http://localhost:5173
TELEGRAM_BOT_TOKEN=

# Public demo deployment profile
# PARVA_ENV=public
# PARVA_ROUTE_PROFILE=public_demo
# PARVA_SOURCE_URL=https://github.com/dantwoashim/Project_Parva
# PARVA_ENABLE_EXPERIMENTAL_API=false
# PARVA_ALLOW_PUBLIC_UNVERIFIED_FUTURE_CONVERSION=false
# PARVA_ALLOW_EXPERIMENTAL_IN_PROD=false
# PARVA_SERVE_FRONTEND=false
# PARVA_RATE_LIMIT_BACKEND=memory
# PARVA_REQUIRE_PRECOMPUTED=false
# CORS_ALLOW_ORIGINS=https://prabinghimire1.com.np,https://www.prabinghimire1.com.np,https://project-parva.pages.dev
# VITE_API_BASE=https://api.prabinghimire1.com.np/v3/api

# Recommended split-hosting production profile
# Frontend: Cloudflare Pages
# Backend: Render public demo or a private ASGI/container host
# Redis: Upstash
#
# PARVA_ENV=production
# PARVA_SOURCE_URL=https://github.com/dantwoashim/Project_Parva
# PARVA_SERVE_FRONTEND=false
# PARVA_RATE_LIMIT_BACKEND=redis
# PARVA_REDIS_URL=rediss://default:<password>@example.upstash.io:6379
# PARVA_REQUIRE_PRECOMPUTED=false
# PARVA_PLACE_SEARCH_ALLOW_REMOTE=false
# PARVA_PLACE_SEARCH_PROVIDER_CHAIN=offline
# PARVA_PLACE_SEARCH_PROVIDER_POLICY=offline_only
# CORS_ALLOW_ORIGINS=https://example.com,https://www.example.com
# VITE_API_BASE=https://api.example.com/v3/api
# NODE_VERSION=20
