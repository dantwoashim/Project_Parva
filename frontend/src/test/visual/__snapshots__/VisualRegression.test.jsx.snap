                  />
                </label>
                <div
                  class="place-result-strip"
                />
                <details
                  class="advanced-birth-settings"
                >
                  <summary>
                    Advanced calculation settings
                  </summary>
                  <div
                    class="coordinate-grid"
                  >
                    <label>
                      Latitude
                      <input
                        value="27.7172"
                      />
                    </label>
                    <label>
                      Longitude
                      <input
                        value="85.324"
                      />
                    </label>
                  </div>
                  <label>
                    Timezone
                    <input
                      value="Asia/Kathmandu"
                    />
                  </label>
                  <div
                    class="method-strip"
                  >
                    <span>
                      Method
                    </span>
                    <strong>
                      Lahiri-style sidereal / Swiss Ephemeris
                    </strong>
                    <small>
                      Birth details stay in this browser session unless you choose to share or export them.
                    </small>
                  </div>
                </details>
                <div
                  class="missing-field-list"
                  role="status"
                >
                  <strong>
                    Still needed
                  </strong>
                  <span>
                    Date of birth
                  </span>
                  <span>
                    Exact birth time
                  </span>
                </div>
                <div
                  class="birth-form-actions"
                >
                  <button
                    class="primary-button"
                    disabled=""
                    type="submit"
                  >
                    Generate Kundali
                  </button>
                  <button
                    class="ghost-button"
                    type="button"
                  >
                    Preview sample
                  </button>
                </div>
              </form>
              <section
                aria-label="Interactive Kundali chart"
                class="panel kundali-card"
              >
                <div
                  aria-label="Chart type"
                  class="birth-chart-switch"
                  role="tablist"
                >
                  <button
                    class="is-active"
                    type="button"
                  >
                    D1 Rashi
                  </button>
                  <button
                    class=""
                    type="button"
                  >
                    D9 Navamsha
                  </button>
                </div>
                <div
                  class="chart-loading"
                >
                  <div
                    aria-hidden="true"
                    class="sample-chart-preview"
                  >
                    <span>
                      1
                    </span>
                    <span>
                      2
                    </span>
                    <span>
                      3
                    </span>
                    <span>
                      4
                    </span>
                    <span>
                      5
                    </span>
                    <span>
                      6
                    </span>
                    <span>
                      7
                    </span>
                    <span>
                      8
                    </span>
                    <span>
                      9
                    </span>
                    <span>
                      10
                    </span>
                    <span>
                      11
                    </span>
                    <span>
                      12
                    </span>
                  </div>
                  <strong>
                    Sample-ready chart preview
                  </strong>
                  <p>
                    Complete the required fields or load the sample profile to see the finished state.
                  </p>
                  <button
                    class="ghost-button"
                    type="button"
                  >
                    Load sample profile
                  </button>
                </div>
              </section>
              <aside
                class="panel birth-brief"
              >
                <p
                  class="eyebrow"
                >
                  Reading brief
                </p>
                <h2>
                  Complete the required fields
                </h2>
                <p>
                  Needed: Date of birth, Exact birth time.
                </p>
                <button
                  class="ghost-button"
                  type="button"
                >
                  Use sample details
                </button>
              </aside>
            </section>
          </main>
        </div>
      </div>
      <footer
        class="parva-footer"
      >
        <span>
          Project Parva
        </span>
        <nav
          aria-label="Footer links"
        >
          <a
            data-discover="true"
            href="/methodology"
          >
            Methodology
          </a>
          <a
            data-discover="true"
            href="/policy"
          >
            Policy
          </a>
          <a
            href="https://github.com/dantwoashim/Project_Parva"
          >
            Source
          </a>
        </nav>
        <small>
          AGPL-3.0-or-later
        </small>
      </footer>
    </div>
  </div>
</div>
`;

