exports[`visual regression harness > kundali page visual baseline 1`] = `
<main
  class="page-shell birth-page"
>
  <section
    class="page-hero"
  >
    <div>
      <h1>
        Birth Reading
      </h1>
      <p>
        A real Kundali instrument: exact birth inputs, Swiss Ephemeris-backed sidereal calculation, interactive D1/D9 charts, dasha timing, and visible provenance.
      </p>
    </div>
  </section>
  <section
    class="birth-workspace"
  >
    <form
      class="panel birth-form"
    >
      <div
        class="panel-heading tight"
      >
        <p
          class="eyebrow"
        >
          Create chart
        </p>
        <strong>
          Birth details
        </strong>
      </div>
      <label>
        Profile name
        <input
          value=""
        />
      </label>
      <label>
        Date of birth
        <input
          type="date"
          value=""
        />
      </label>
      <label>
        Exact birth time
        <input
          type="time"
          value=""
        />
      </label>
      <label>
        Birth place
        <input
          placeholder="Search backend places"
          value=""
        />
      </label>
      <div
        class="place-result-strip"
      />
      <div
        class="coordinate-grid"
      >
        <label>
          Latitude
          <input
            value="27.7172"
          />
        </label>
        <label>
          Longitude
          <input
            value="85.324"
          />
        </label>
      </div>
      <label>
        Timezone
        <input
          value="Asia/Kathmandu"
        />
      </label>
      <div
        class="method-strip"
      >
        <span>
          Method
        </span>
        <strong>
          Lahiri-style sidereal / Swiss Ephemeris
        </strong>
      </div>
      <button
        class="primary-button"
        disabled=""
        type="submit"
      >
        Generate Kundali
      </button>
    </form>
    <section
      aria-label="Interactive Kundali chart"
      class="panel kundali-card"
    >
      <div
        aria-label="Chart type"
        class="birth-chart-switch"
        role="tablist"
      >
        <button
          class="is-active"
          type="button"
        >
          D1 Rashi
        </button>
        <button
          class=""
          type="button"
        >
          D9 Navamsha
        </button>
      </div>
      <div
        class="chart-loading"
      >
        <strong>
          Chart will appear here
        </strong>
        <p>
          Enter exact birth details to generate the Kundali.
        </p>
      </div>
    </section>
    <aside
      class="panel birth-brief"
    >
      <p
        class="eyebrow"
      >
        Reading brief
      </p>
      <h2>
        Waiting for calculation
      </h2>
      <p>
        The interpretation appears only after real chart data is returned.
      </p>
    </aside>
  </section>
</main>
`;

