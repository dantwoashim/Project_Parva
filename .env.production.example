# Project Parva hardened deployment template

PARVA_ENV=production
PARVA_LICENSE_MODE=AGPL-3.0-or-later
PARVA_SOURCE_URL=https://github.com/dantwoashim/Project_Parva
PARVA_SERVE_FRONTEND=false
PARVA_FRONTEND_DIST=./frontend/dist

PARVA_ENABLE_EXPERIMENTAL_API=false
PARVA_SHOW_PRIVATE_SCHEMA=false
PARVA_ALLOW_EXPERIMENTAL_IN_PROD=false
PARVA_ALLOW_PUBLIC_UNVERIFIED_FUTURE_CONVERSION=false
PARVA_ROUTE_PROFILE=developer_preview
PARVA_MAX_REQUEST_BYTES=1048576
PARVA_MAX_QUERY_LENGTH=4096

PARVA_ADMIN_TOKEN=replace-with-a-long-random-secret
PARVA_API_KEYS=

PARVA_BILLING_ENABLED=false
PARVA_DATABASE_URL=postgresql://user:password@host:5432/parva
PARVA_API_KEY_PEPPER=replace-with-a-long-random-secret
PARVA_KHALTI_SECRET_KEY=
PARVA_KHALTI_PUBLIC_KEY=
PARVA_KHALTI_BASE_URL=https://a.khalti.com/api/v2
PARVA_KHALTI_RETURN_URL=https://example.com/pricing/success
PARVA_ESEWA_MERCHANT_ID=
PARVA_ESEWA_SECRET=
PARVA_ESEWA_BASE_URL=https://epay.esewa.com.np
PARVA_ESEWA_RETURN_URL=https://example.com/pricing/success

PARVA_RATE_LIMIT_ENABLED=true
PARVA_RATE_LIMIT_BACKEND=redis
PARVA_REDIS_URL=rediss://default:password@example.upstash.io:6379
PARVA_REQUIRE_PRECOMPUTED=false
PARVA_PREWARM_HOTSET=true
PARVA_PRECOMPUTED_STALE_HOURS=720
PARVA_RUNTIME_CACHE_ENABLED=true
PARVA_RUNTIME_CACHE_MAX_ENTRIES=512
PARVA_TRUSTED_PROXY_IPS=

PARVA_PLACE_SEARCH_ALLOW_REMOTE=false
PARVA_PLACE_SEARCH_PROVIDER_CHAIN=offline
PARVA_PLACE_SEARCH_PROVIDER_POLICY=offline_only
PARVA_PLACE_SEARCH_ENDPOINT=https://nominatim.openstreetmap.org/search
PARVA_PLACE_SEARCH_USER_AGENT=ProjectParva/3.0 (+https://example.com/contact)

VITE_API_BASE=https://api.example.com/v3/api
VITE_API_TIMEOUT_MS=10000

CORS_ALLOW_ORIGINS=https://example.com,https://www.example.com
PARVA_CORS_ORIGINS=https://example.com,https://www.example.com

