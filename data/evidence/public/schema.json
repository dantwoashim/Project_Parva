{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-parva.local/schemas/evidence-public.schema.json",
  "title": "Public Evidence Packet",
  "type": "object",
  "required": [
    "source_id",
    "source_type",
    "source_reference",
    "source_tier",
    "ingestion_time",
    "checksum",
    "extracted_rows",
    "normalized_rows",
    "review_status",
    "reviewer_required",
    "public_safe",
    "authority_boundary",
    "benchmark_candidate"
  ],
  "properties": {
    "source_id": { "type": "string", "minLength": 1 },
    "source_type": { "type": "string" },
    "source_reference": { "type": "string", "minLength": 1 },
    "source_tier": { "type": "string" },
    "ingestion_time": { "type": "string" },
    "checksum": { "type": "string", "minLength": 64, "maxLength": 64 },
    "extracted_rows": { "type": "array", "minItems": 1 },
    "normalized_rows": { "type": "array", "minItems": 1 },
    "review_status": { "enum": ["unreviewed", "reviewed", "rejected"] },
    "reviewer_required": { "type": "boolean" },
    "public_safe": { "const": true },
    "authority_boundary": { "type": "string", "minLength": 1 },
    "benchmark_candidate": { "type": "boolean" }
  }
}

