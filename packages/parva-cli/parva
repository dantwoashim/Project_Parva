#!/usr/bin/env python3
"""Tiny local Parva verifier CLI for Phase 05/06 demos."""

from __future__ import annotations

import json
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[2]
sys.path.insert(0, str(ROOT / "backend"))

from app.membranes.proof_origami import unfold  # noqa: E402
from app.membranes.verifier import verify_membrane  # noqa: E402


def main(argv: list[str]) -> int:
    if len(argv) < 3:
        print("usage: parva verify|unfold <membrane.json> [compact|audit|replay]")
        return 2
    command = argv[1]
    membrane = json.loads(Path(argv[2]).read_text(encoding="utf-8"))
    if command == "verify":
        ok, reason = verify_membrane(membrane)
        print(json.dumps({"ok": ok, "reason": reason}, sort_keys=True))
        return 0 if ok else 1
    if command == "unfold":
        level = argv[3] if len(argv) > 3 else "compact"
        print(json.dumps(unfold(membrane, level), indent=2, sort_keys=True))
        return 0
    return 2


if __name__ == "__main__":
    raise SystemExit(main(sys.argv))
