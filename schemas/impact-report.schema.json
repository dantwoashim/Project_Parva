{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-parva.example/schemas/impact-report.schema.json",
  "title": "Parva Temporal Impact Run",
  "type": "object",
  "required": ["impact_run_id", "change_set_id", "summary", "impacts", "meta"],
  "properties": {
    "impact_run_id": {"type": "string"},
    "created_at": {"type": "string"},
    "change_set_id": {"type": "string"},
    "mode": {"type": "string"},
    "summary": {"type": "object"},
    "impacts": {
      "type": "array",
      "items": {"type": "object"}
    },
    "recommendations": {
      "type": "array",
      "items": {"type": "string"}
    },
    "meta": {"type": "object"}
  },
  "additionalProperties": true
}
