{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dantwoashim/Project_Parva/schemas/source-registry.schema.json",
  "title": "SourceRegistry",
  "description": "A public-safe registry of source metadata used by a Project Parva release.",
  "type": "object",
  "additionalProperties": false,
  "required": ["registry_id", "version", "generated_at", "sources", "claim_boundary"],
  "properties": {
    "registry_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "source_name",
          "source_tier",
          "description",
          "claim_support_level",
          "notes"
        ],
        "properties": {
          "source_id": {
            "type": "string",
            "minLength": 1
          },
          "source_name": {
            "type": "string",
            "minLength": 1
          },
          "source_tier": {
            "type": "string",
            "enum": [
              "official",
              "semi_official",
              "public_corpus",
              "publisher",
              "calculated",
              "fixture",
              "research",
              "private",
              "unknown"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "claim_support_level": {
            "type": "string",
            "enum": [
              "official_grade",
              "reviewed_reference",
              "public_demo",
              "shape_only",
              "not_for_claims",
              "official_interpretation_not_legal_authority",
              "public_corpus_reference_only",
              "calendar_computation_not_legal_authority",
              "astronomical_calculation_subject_to_source_model",
              "enterprise_decision_support_not_legal_authority",
              "research_preview_not_safe_for_legal_or_payroll_use"
            ]
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "reviewed_at": {
            "type": "string",
            "format": "date-time"
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "claim_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["official_publication_override", "future_outputs_status"],
      "properties": {
        "official_publication_override": {
          "type": "boolean"
        },
        "future_outputs_status": {
          "type": "string",
          "const": "computed_prediction_not_official"
        },
        "notes": {
          "type": "string"
        }
      }
    }
  },
  "examples": [
    {
      "registry_id": "parva-bs-public-demo-sources",
      "version": "0.1.0",
      "generated_at": "2026-05-12T00:00:00Z",
      "sources": [
        {
          "source_id": "parva-temporal-spec-v0-1",
          "source_name": "Project Parva Temporal Specification v0.1",
          "source_tier": "publisher",
          "description": "Public specification defining temporal contracts and claim boundaries.",
          "claim_support_level": "public_demo",
          "url": "https://github.com/dantwoashim/Project_Parva",
          "reviewed_at": "2026-05-12T00:00:00Z",
          "notes": "Contract metadata only. Not an official government calendar publication."
        }
      ],
      "claim_boundary": {
        "official_publication_override": true,
        "future_outputs_status": "computed_prediction_not_official",
        "notes": "Future-BS research output is review metadata unless an official source publishes it."
      }
    }
  ]
}
