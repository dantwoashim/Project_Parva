{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dantwoashim/Project_Parva/schemas/reconciliation-event.schema.json",
  "title": "ReconciliationEvent",
  "description": "A controlled calendar reconciliation event for release and review workflows.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event",
    "release_version",
    "affected_years",
    "affected_months",
    "requires_review",
    "diff_available",
    "publication_status"
  ],
  "properties": {
    "event": {
      "type": "string",
      "enum": [
        "calendar.official_release.verified",
        "calendar.risk_label.changed",
        "calendar.external_sheet.disagreement_detected",
        "calendar.month_boundary.review_required"
      ]
    },
    "release_version": { "type": "string", "minLength": 1 },
    "affected_years": {
      "type": "array",
      "items": { "type": "integer", "minimum": 1 },
      "minItems": 1
    },
    "affected_months": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9]{4}-[0-9]{2}$"
      }
    },
    "requires_review": { "type": "boolean" },
    "diff_available": { "type": "boolean" },
    "publication_status": {
      "type": "string",
      "enum": [
        "official_verified",
        "printed_verified",
        "public_witness",
        "publisher_reference",
        "software_table_reference",
        "third_party_reference",
        "needs_review",
        "computed_prediction_not_official"
      ]
    },
    "signature": { "type": "string", "minLength": 1 }
  },
  "examples": [
    {
      "event": "calendar.official_release.verified",
      "release_version": "published-bs-2080-v1",
      "affected_years": [2080],
      "affected_months": ["2080-01"],
      "requires_review": false,
      "diff_available": true,
      "publication_status": "official_verified",
      "signature": "example-signature-placeholder"
    }
  ]
}
