{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-parva.local/schemas/evidence-packet.schema.json",
  "title": "Project Parva Evidence Packet",
  "type": "object",
  "required": [
    "source_id",
    "source_type",
    "source_reference",
    "source_tier",
    "ingestion_time",
    "checksum",
    "extracted_rows",
    "normalized_rows",
    "review_status",
    "reviewer_required",
    "public_safe",
    "authority_boundary",
    "benchmark_candidate"
  ],
  "properties": {
    "source_id": { "type": "string", "minLength": 1 },
    "source_type": { "enum": ["pdf", "csv", "notice", "web_page", "manual_public_reference"] },
    "source_reference": { "type": "string", "minLength": 1 },
    "source_tier": {
      "enum": [
        "official_verified",
        "printed_verified",
        "public_witness",
        "publisher_reference",
        "software_table_reference",
        "third_party_reference",
        "needs_review"
      ]
    },
    "ingestion_time": { "type": "string" },
    "checksum": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "extracted_rows": { "type": "array", "minItems": 1 },
    "normalized_rows": { "type": "array", "minItems": 1 },
    "review_status": { "enum": ["unreviewed", "reviewed", "rejected"] },
    "reviewer_required": { "type": "boolean" },
    "public_safe": { "const": true },
    "authority_boundary": {
      "type": "string",
      "not": {
        "enum": [
          "government_authority",
          "legal_authority",
          "tax_authority",
          "banking_authority",
          "payroll_authority",
          "official_future_date",
          "religious_authority"
        ]
      }
    },
    "benchmark_candidate": { "type": "boolean" }
  }
}

