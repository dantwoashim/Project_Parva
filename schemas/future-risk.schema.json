{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dantwoashim/Project_Parva/schemas/future-risk.schema.json",
  "title": "FutureBSRiskAssessment",
  "description": "A future BS risk posture record that does not include corrected future values by default.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "bs_year",
    "bs_month",
    "publication_status",
    "risk_label",
    "corrected_value_included",
    "reason_codes",
    "source_policy"
  ],
  "properties": {
    "bs_year": { "type": "integer", "minimum": 1 },
    "bs_month": { "type": "integer", "minimum": 1, "maximum": 12 },
    "publication_status": { "const": "computed_prediction_not_official" },
    "risk_label": { "type": "string", "enum": ["GREEN", "YELLOW", "RED"] },
    "corrected_value_included": { "type": "boolean" },
    "reason_codes": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1
    },
    "source_policy": {
      "type": "string",
      "enum": [
        "official_strict",
        "printed_reviewed",
        "public_witness",
        "publisher_reference",
        "software_table_reference",
        "third_party_reference",
        "experimental_shadow",
        "public_demo"
      ]
    },
    "trace_id": { "type": "string", "minLength": 1 }
  },
  "examples": [
    {
      "bs_year": 9000,
      "bs_month": 7,
      "publication_status": "computed_prediction_not_official",
      "risk_label": "YELLOW",
      "corrected_value_included": false,
      "reason_codes": ["boundary_sensitive", "review_recommended"],
      "source_policy": "public_demo",
      "trace_id": "trace-risk-public-example-001"
    }
  ]
}
