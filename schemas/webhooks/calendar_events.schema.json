{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dantwoashim/Project_Parva/schemas/webhooks/calendar_events.schema.json",
  "title": "Project Parva Calendar Webhook Event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_type",
    "release_version",
    "source_tier",
    "affected_bs_year",
    "affected_months",
    "requires_review",
    "publication_status",
    "signature"
  ],
  "properties": {
    "event_type": {
      "type": "string",
      "enum": [
        "calendar.official_release.verified",
        "calendar.release.diff_available",
        "calendar.risk_label.changed",
        "calendar.schedule.review_required",
        "calendar.future_assumption.resolved"
      ]
    },
    "release_version": {
      "type": "string",
      "minLength": 1
    },
    "source_tier": {
      "type": "string",
      "enum": [
        "official",
        "semi_official",
        "printed_verified",
        "public_witness",
        "publisher_reference",
        "software_table_reference",
        "third_party",
        "calculated",
        "fixture",
        "research_private",
        "unknown"
      ]
    },
    "affected_bs_year": {
      "type": "integer",
      "minimum": 1900,
      "maximum": 2200
    },
    "affected_months": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "requires_review": {
      "type": "boolean"
    },
    "publication_status": {
      "const": "computed_prediction_not_official"
    },
    "signature": {
      "type": "string",
      "description": "Placeholder for deployment-specific event signing."
    }
  }
}
