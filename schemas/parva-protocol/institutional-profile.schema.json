      "risk_policy": {
        "future_date_action": "human_review_required",
        "unsupported_result_action": "human_review_required"
      }
    }
  ],
  "$id": "https://api.prabinghimire1.com.np/schemas/parva-protocol/institutional-profile.schema.json"
