    "jurisdiction",
    "risk_policy"
  ],
  "properties": {
    "profile_id": {
      "type": "string"
    },
    "label": {
      "type": "string"
    },
    "jurisdiction": {
      "type": "string"
    },
    "risk_policy": {
      "type": "object"
    }
