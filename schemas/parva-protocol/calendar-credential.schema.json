{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-parva.example/schemas/parva-protocol/calendar-credential.schema.json",
  "title": "Parva Calendar Credential",
  "type": "object",
  "required": [
    "credential_id",
    "type",
    "protocol_version",
    "issuer",
    "issued_at",
    "claim",
    "release_id",
    "source_ids",
    "confidence",
    "claim_boundary",
    "status",
    "proof"
  ],
  "properties": {
    "credential_id": {"type": "string"},
    "type": {"type": "array", "items": {"type": "string"}},
    "protocol_version": {"type": "string"},
    "issuer": {"type": "object"},
    "issued_at": {"type": "string"},
    "claim": {"type": "object"},
    "release_id": {"type": "string"},
    "source_ids": {"type": "array", "items": {"type": "string"}},
    "confidence": {
      "type": "string",
      "enum": ["official_verified", "source_backed", "calculated", "fixture_only", "research_preview", "disputed", "unsupported", "unknown"]
    },
    "claim_boundary": {"type": "string"},
    "status": {
      "type": "string",
      "enum": ["valid", "revoked", "expired", "unsigned_preview", "hash_only_preview", "unverifiable"]
    },
    "proof": {"type": "object"},
    "warnings": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
