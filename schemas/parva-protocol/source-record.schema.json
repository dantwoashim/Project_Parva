{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Parva Protocol Source Record",
  "type": "object",
  "required": ["source_id", "source_name", "source_tier"],
  "properties": {
    "source_id": {"type": "string"},
    "source_name": {"type": "string"},
    "source_tier": {
      "type": "string",
      "enum": ["official", "semi_official", "public_corpus", "publisher", "calculated", "fixture", "research", "private", "unknown"]
    },
    "claim_support_level": {"type": "string"},
    "url": {"type": ["string", "null"]}
  },
  "additionalProperties": false,
  "examples": [
    {
      "source_id": "parva_public_bs_ad_corpus",
      "source_name": "Project Parva public BS AD corpus",
      "source_tier": "public_corpus",
      "claim_support_level": "source_backed",
      "url": null
    }
  ]
}
