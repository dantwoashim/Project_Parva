{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-parva.example/schemas/parva-protocol/offline-bundle-manifest.schema.json",
  "title": "Parva Offline Bundle Manifest",
  "type": "object",
  "required": ["bundle_id", "protocol_version", "contents", "checksums", "signature_status", "claim_boundary"],
  "properties": {
    "bundle_id": {"type": "string"},
    "protocol_version": {"type": "string"},
    "created_at": {"type": "string"},
    "contents": {"type": "array", "items": {"type": "object"}},
    "checksums": {"type": "object"},
    "signature": {"type": ["string", "null"]},
    "signature_status": {"type": "string", "enum": ["unsigned_preview", "signed", "unverified"]},
    "claim_boundary": {"type": "string"}
  },
  "additionalProperties": true
}
